{
  "name": "gh-paddock",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "gate": "npm run scan && npm run lint && npm run types && npm test && npm run go",
    "scan": "node scripts/public-repo-scan.mjs",
    "lint": "eslint . --max-warnings 0",
    "types": "tsc -p .",
    "test": "node --experimental-strip-types --no-warnings=ExperimentalWarning --test --test-concurrency=4 'test/**/*.test.ts'",
    "go": "gofmt -l cmd internal | (! grep .) && go vet ./cmd/... ./internal/... && go test ./cmd/... ./internal/..."
  },
  "devDependencies": {
    "@aws-sdk/client-cloudformation": "3.1044.0",
    "@aws-sdk/client-ecs": "3.1044.0",
    "@eslint/js": "9.39.4",
    "@types/js-yaml": "4.0.9",
    "@types/node": "25.3.3",
    "@typescript-eslint/parser": "8.59.0",
    "eslint": "9.39.4",
    "globals": "14.0.0",
    "js-yaml": "4.3.2",
    "typescript": "5.9.3"
  }
}
